{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>globis-org/renovate-config:terraform"
  ],
  "prHourlyLimit": 1,
  "prConcurrentLimit": 10,
  "rebaseWhen": "automerging",
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ]
}
