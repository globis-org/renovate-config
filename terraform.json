{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["terraform"],
      "matchPackagePatterns": ["^app.terraform.io/gdp-sre"],
      "enabled": false
    },
    {
      "matchManagers": ["terraform"],
      "matchPackageNames": ["terraform-aws-modules/iam/aws"],
      "allowedVersions": "<6.0.0",
      "description": "Restrict IAM module to v5.x due to breaking changes in v6"
    },
    {
      "matchManagers": ["terraform"],
      "matchFileNames": ["terraform/**/*"],
      "additionalBranchPrefix": "terraform/{{ lookup (split packageFileDir '/') 1 }}-",
      "commitMessageSuffix": "(terraform/{{ lookup (split packageFileDir '/') 1 }})",
      "groupName": "terraform states",
      "groupSlug": "tfstates",
      "description": "Group Terraform updates by the first subdirectory under terraform/ (e.g. terraform/foo/**/*).",
      "automerge": true,
      "major": {
        "automerge": false
      },
      "rangeStrategy": "pin"
    }
  ]
}
